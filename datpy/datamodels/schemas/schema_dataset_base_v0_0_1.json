{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "0.0.1",
  "title": "DatasetBase",
  "description": "Dataset with experimental measurements and uncertainties",
  "type": "object",
  "properties": {
    "dataset_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "year": {
      "type": "integer",
      "minimum": 1900
    },
    "author": {
      "type": "string",
      "maxLength": 28
    },
    "pubref": {
      "type": "string",
      "maxLength": 20
    },
    "tag": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "quantity_type": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "num_reaction_ids": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "reaction_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 1,
      "maxItems": 5
    },
    "ENF": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 10,
      "maxItems": 10
    },
    "NENF": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999
      },
      "minItems": 10,
      "maxItems": 10
    },
    "EPA": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 11,
        "maxItems": 11
      },
      "minItems": 3,
      "maxItems": 3
    },
    "NETG": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999
      },
      "minItems": 11,
      "maxItems": 11
    },
    "energies": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "measured_values": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "minItems": 12,
      "maxItems": 12
    },
    "NCST": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 99999
      }
    },
    "NEC": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "minItems": 10,
        "maxItems": 10
      },
      "minItems": 2,
      "maxItems": 2
    },
    "FCFC": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "minItems": 10,
      "maxItems": 10
    },
    "cormat": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        }
      }
    }
  },
  "required": [
    "dataset_id",
    "year",
    "author",
    "pubref",
    "tag",
    "quantity_type",
    "comments",
    "num_reaction_ids",
    "reaction_ids",
    "EPA",
    "NETG",
    "energies",
    "measured_values",
    "uncertainties",
    "NCST",
    "NEC",
    "FCFC"
  ]
}