{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "0.0.1",
  "title": "ReactionPriorBase",
  "description": "List of energy-dependent cross sections with prior values",
  "type": "object",
  "patternProperties": {
    "^[0-9]+$": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16
        },
        "reaction_id": {
          "type": "integer",
          "minimum": 1
        },
        "energies": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "cross_sections": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "label",
        "energies",
        "cross_sections"
      ]
    }
  },
  "additionalProperties": false
}